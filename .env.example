# Trino authenticates against trino-iceberg/etc/trino/password.db, which is not in
# git. Create it from these two values, along with the TLS keystore:
#   bash trino-iceberg/generate-dev-credentials.sh
TRINO_USERNAME=trino_admin
TRINO_PASSWORD=change-me
# Host only, no port - the clients append :8443 themselves.
TRINO_IP_ADDRESS=localhost
# Both are read by the committed trino-iceberg/etc/config.properties via ${ENV:...},
# so no secret has to live in that file. Changing either one means regenerating:
#   bash trino-iceberg/generate-dev-credentials.sh --force
TRINO_KEYSTORE_PASSWORD=change-me
# Authenticates Trino's internal communication - any long random string:
#   openssl rand -base64 32
TRINO_SHARED_SECRET=change-me
MONITORING_URL=

MLFLOW_TRACKING_URI=http://mlflow:5000

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Postgres credentials
POSTGRES_USER=mlflow_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow_db

# Grafana credentials
GF_SECURITY_ADMIN_USER=grafana_admin
GF_SECURITY_ADMIN_PASSWORD=change-me
