# Normalise line endings across Windows / macOS / Linux checkouts.
# Without this the repo shows every file as modified when a Windows and a
# macOS working copy meet, which buries real changes in tens of thousands
# of phantom diff lines.
#
# `text=auto eol=lf` means: git decides what is text, stores LF in the
# repository, and checks out LF everywhere. Editors on Windows handle LF
# fine; the previous behaviour did not.

* text=auto eol=lf

# Explicit text types (belt and braces for files git might guess wrong on)
*.py      text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.csv     text eol=lf
*.json    text eol=lf
*.toml    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.sql     text eol=lf
*.cfg     text eol=lf
*.ini     text eol=lf
*.sh      text eol=lf
Dockerfile        text eol=lf
.gitattributes    text eol=lf
.gitignore        text eol=lf
.python-version   text eol=lf

# Binary — never touch these
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary
*.pkl     binary
*.db      binary
*.parquet binary
*.xlsx    binary
*.pptx    binary
*.key     binary
*.zip     binary
*.gz      binary
