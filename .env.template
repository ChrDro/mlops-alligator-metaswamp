TRINO_USERNAME=
TRINO_PASSWORD=
TRINO_IP_ADDRESS=
MLFLOW_TRACKING_URI=http://host.docker.internal:5000
MONITORING_URL=

# Required by scripts/setup_stack.sh — it aborts if any of these is empty.
# The defaults below work for a local stack; both services are initialised from
# them on first start, so changing one later needs a `docker compose down -v`.

# MinIO credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me

# Postgres credentials
POSTGRES_USER=mlflow_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mlflow_db
